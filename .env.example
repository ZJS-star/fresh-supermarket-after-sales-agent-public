# Chat Completions-compatible endpoint with image input AND function tools.
# Never commit real values. Empty MODEL_NAME intentionally disables live model calls.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_TOKENS=2000
MODEL_TOKEN_LIMIT_FIELD=max_completion_tokens
# Optional Qwen hybrid-thinking switch. Blank omits the provider-specific parameter.
MODEL_ENABLE_THINKING=
AGENT_MAX_STEPS=16
# Local development only. Separate random customer/staff capabilities are generated per run.
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
